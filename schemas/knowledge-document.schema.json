{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EKOS Knowledge Document Metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "technology",
    "category",
    "content_type",
    "difficulty",
    "status",
    "created",
    "sources",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "technology": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_type": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ]
    },
    "version_scope": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "verified",
        "deprecated"
      ]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "last_reviewed": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "review_due": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}